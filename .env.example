# =============================================================================
# Cloud Spanner Enterprise SDLC Knowledge Graph & GraphRAG Workshop — .env
# =============================================================================
# Copy this file to `.env` (gitignored) and set GOOGLE_CLOUD_PROJECT before
# running any live GCP provisioning, ingestion, or MCP deployment commands.
# NEVER commit `.env`, static API keys, OAuth client secrets, or SA JSON keys.
# =============================================================================

# --- Required GCP Project ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# SPANNER_PROJECT=  # Optional override; defaults to GOOGLE_CLOUD_PROJECT

# --- Locked Regional Architecture (Bangkok Primary + Singapore AI & DR) ---
# Primary operational region (Bangkok, Thailand — 3-zone sync quorum, 99.99% SLA,
# Thailand PDPA residency; verified 2026 Enterprise compute: $1.2915/node-hr).
GOOGLE_CLOUD_REGION=asia-southeast3
SPANNER_REGION=asia-southeast3
SPANNER_INSTANCE_CONFIG=regional-asia-southeast3

# Secondary companion region (Singapore, ~25 ms RTT from Bangkok):
# Vertex AI embeddings & LLM, Model Armor templates, cross-region DR backup copy,
# and lab quota fallback ($1.40712/node-hr Enterprise compute).
GOOGLE_CLOUD_SECONDARY_REGION=asia-southeast1
SPANNER_SECONDARY_INSTANCE_CONFIG=regional-asia-southeast1
SPANNER_SECONDARY_INSTANCE=sdlc-kg-dr-singapore

# --- Cloud Spanner Enterprise Sandbox Defaults ---
# NOTE: 100 PUs ($0.12915/hr Bangkok Enterprise; ~$1.15 total for 8-hr workshop)
# is strictly for workshop/dev sandboxes. Production requires >= 1,000 PUs (1 node).
SPANNER_INSTANCE=sdlc-kg-enterprise
SPANNER_DATABASE=sdlc_knowledge_graph
SPANNER_EDITION=ENTERPRISE
SPANNER_DIALECT=googlesql
SPANNER_PROCESSING_UNITS=100

# --- Vertex AI Models (Secretless via ADC / Cloud Run Workload Identity) ---
# CRITICAL (INV-09): Vertex AI predict-API text embedding models
# (gemini-embedding-001) REQUIRE a regional endpoint such as asia-southeast1.
# NEVER set VERTEX_AI_LOCATION=global for embeddings!
VERTEX_AI_LOCATION=asia-southeast1
VERTEX_AI_EMBEDDING_LOCATION=asia-southeast1
VERTEX_AI_LLM_FALLBACK_LOCATION=global
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-2.5-flash

# --- Optional Lab 3 Dataflow Bulk Migration & Cross-Encoder Reranker ---
# GCS_BUCKET=your-gcp-project-id-sdlc-kg-asia-southeast3
# DATAFLOW_REGION=asia-southeast3
# DATAFLOW_FALLBACK_REGION=asia-southeast1
# RERANKER_ENDPOINT_ID=

# --- Optional Lab 6 MCP Toolbox, OIDC Auth & Model Armor (Singapore) ---
# OAuth 2.0 Client ID ONLY (never put OAuth client secrets in .env or YAML)
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
MODEL_ARMOR_LOCATION=asia-southeast1
MODEL_ARMOR_TEMPLATE_ID=sdlc-agent-guardrail-sg
# MODEL_ARMOR_TEMPLATE=projects/your-gcp-project-id/locations/asia-southeast1/templates/sdlc-agent-guardrail-sg
# IMPACT_ANALYST_MCP_URL=https://sdlc-mcp-impact-analyst-PROJECT_HASH-as.a.run.app
# ADR_CURATOR_MCP_URL=https://sdlc-mcp-adr-curator-PROJECT_HASH-as.a.run.app
# SECURITY_AUDITOR_MCP_URL=https://sdlc-mcp-security-auditor-PROJECT_HASH-as.a.run.app
# MCP_BEARER_TOKEN=
# GOOGLE_OIDC_ID_TOKEN=
